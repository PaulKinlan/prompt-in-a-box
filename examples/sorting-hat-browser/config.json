{
  "version": "1.0.0",
  "providers": {
    "allowed": [
      "google"
    ],
    "default": "google",
    "lockProvider": false
  },
  "models": {
    "default": "gemini-3.8-flash",
    "lockModel": false,
    "allowCustomModelInput": true,
    "allowed": {
      "google": [
        "gemini-3.8-flash",
        "gemini-4-argon"
      ]
    }
  },
  "schedule": {
    "defaultAlarmMinutes": 15,
    "lockSchedule": false
  },
  "providerTools": {
    "disabledByDefault": [],
    "lockProviderTools": false
  },
  "agentSettings": {
    "storageKey": "sorting_hat_state",
    "title": "Sorting Hat Preferences",
    "fields": [
      {
        "id": "sortMode",
        "label": "Sorting Scope",
        "hint": "Choose whether to sort only ungrouped tabs or re-evaluate all tabs (status quo).",
        "type": "select",
        "default": "ungrouped_only",
        "options": [
          {
            "label": "Sort only ungrouped tabs",
            "value": "ungrouped_only"
          },
          {
            "label": "Status quo (re-sort existing groups too)",
            "value": "status_quo"
          }
        ]
      },
      {
        "id": "usePageContent",
        "label": "Use page content (tab_read)",
        "hint": "Gather rendered text, headings, and descriptions from pages for smarter topic grouping.",
        "type": "boolean",
        "default": true
      },
      {
        "id": "waitForIdle",
        "label": "Wait for browser idle",
        "hint": "Only run automatic scheduled sorting when the browser is idle so active work isn't interrupted.",
        "type": "boolean",
        "default": true
      }
    ]
  },
  "ui": {
    "showCosts": false,
    "showTokenUsage": false,
    "showToolCallDetails": true,
    "showHistory": true,
    "showVersionBadge": true,
    "showPolicyBadge": true,
    "showPopupHeader": true,
    "showViewSwitcher": true,
    "showStatusCard": true,
    "showKeyStatusBadge": true,
    "showScheduleSummary": true,
    "showRecentArtifacts": true,
    "showPopupFooter": false,
    "allowSettingsAccess": true,
    "allowSidePanel": false,
    "showSidePanelHeader": true,
    "showSidePanelStatusBar": true,
    "showActivityDrawer": true,
    "showRecentRuns": true,
    "showOnboardingBanner": true,
    "showProviderSelector": true,
    "showApiKeyInput": true,
    "showModelSelector": true,
    "showProviderTools": true,
    "showPermissionsManager": true,
    "showSchedule": true,
    "allowTestConnection": true,
    "allowManualRun": true,
    "showAuditLog": true,
    "showAuditStats": true,
    "showAuditFilters": true,
    "allowExportAudit": true,
    "allowClearAudit": true,
    "allowArtifacts": true,
    "showArtifactStats": true,
    "showArtifactFilters": true,
    "allowCopyArtifact": true,
    "allowDownloadArtifact": true,
    "allowDeleteArtifacts": true
  },
  "features": {
    "showProviderSelector": true,
    "showModelSelector": true,
    "showProviderTools": false,
    "showPermissionsManager": false,
    "showSchedule": true,
    "showAuditLog": false,
    "allowExportAudit": true,
    "allowClearAudit": true,
    "allowSidePanel": true,
    "allowArtifacts": true,
    "allowManualRun": true
  }
}
