  "agentSettings": {
    "storageKey": "sorting_hat_state",
    "title": "Sorting Hat Preferences",
    "fields": [
      {
        "id": "preferExistingGroups",
        "label": "Fit into existing groups first",
        "hint": "Match newly opened ungrouped tabs into relevant existing tab groups before creating any new group.",
        "type": "boolean",
        "default": true
      },
      {
        "id": "sortMode",
        "label": "Sorting Scope",
        "hint": "Only sort ungrouped tabs (never pull tabs out of existing groups) or re-evaluate all tabs across groups.",
        "type": "select",
        "default": "ungrouped_only",
        "options": [
          {
            "label": "Only ungrouped tabs (keep existing groups)",
            "value": "ungrouped_only"
          },
          {
            "label": "Re-evaluate all tabs (full reshuffle)",
            "value": "status_quo"
          }
        ]
      },
      {
        "id": "minTabsForNewGroup",
        "label": "Minimum tabs for new group",
        "hint": "Keep isolated tabs ungrouped unless there are enough related tabs to warrant a new group.",
        "type": "select",
        "default": "2",
        "options": [
          {
            "label": "At least 2 tabs",
            "value": "2"
          },
          {
            "label": "At least 3 tabs",
            "value": "3"
          }
        ]
      },
      {
        "id": "autoCollapse",
        "label": "Auto-collapse new groups",
        "hint": "Automatically collapse newly formed groups to save horizontal tabstrip space.",
        "type": "boolean",
        "default": false
      },
      {
        "id": "namingStyle",
        "label": "Group naming style",
        "hint": "Choose between concise broad categories or descriptive project/task names.",
        "type": "select",
        "default": "short_category",
        "options": [
          {
            "label": "Short category (e.g. Docs, Shopping)",
            "value": "short_category"
          },
          {
            "label": "Task / Project specific (e.g. Q4 Planning)",
            "value": "task_specific"
          }
        ]
      },
      {
        "id": "usePageContent",
        "label": "Use page content (tab_read)",
        "hint": "Inspect page body text for ambiguous tabs (slower). Off by default for instant single-step sorting.",
        "type": "boolean",
        "default": false
      },
      {
        "id": "waitForIdle",
        "label": "Wait for browser idle",
        "hint": "Only run automatic scheduled sorting when the browser is idle so active work isn't interrupted.",
        "type": "boolean",
        "default": false
      }
    ]
  },
