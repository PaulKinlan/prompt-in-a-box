{
  "name": "prompt-in-a-box",
  "version": "0.7.9",
  "private": true,
  "description": "A Chrome extension whose entire logic is a prompt. Load prompt.md, run an agent-do loop on a schedule, act through Chrome APIs granted by the manifest.",
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "watch": "node build.js --watch",
    "typecheck": "tsc --noEmit",
    "pack": "node scripts/pack.js",
    "bump": "node scripts/version.js",
    "version:status": "node scripts/version.js --status",
    "release": "npm run build && npm run pack",
    "create": "node scripts/create.js",
    "use": "node scripts/use.js",
    "icons": "node scripts/gen-icons.js"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.83",
    "@ai-sdk/google": "^4.0.100",
    "@ai-sdk/openai": "^4.0.97",
    "agent-do": "^0.7.0",
    "ai": "^7.0.145",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3"
  }
}
